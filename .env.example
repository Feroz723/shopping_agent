# SerpAPI (primary, 100 free/mo) — set USE_SERPAPI=false to disable and use pure scraping
SERPAPI_API_KEY=20e48742cde1b4995722791866cdf09e9e15519126aad42a41160a08af5d7d7b
USE_SERPAPI=true
# SCRAPING_MODE=pure → true $0 (Brave/DuckDuckGo + Cheerio), no SerpAPI calls
SCRAPING_MODE=
# Brave Search (fallback, paid after trial) — https://api.search.brave.com — OPTIONAL
BRAVE_SEARCH_API_KEY=
# DuckDuckGo HTML fallback is $0 and needs no key — auto-used when Brave key missing

# Database (Railway / Neon / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/scout_db
# Run: npx prisma migrate deploy && npx prisma generate

# Affiliate
AMAZON_ASSOCIATE_ID=scout-20

# Cache & Rate limit (Upstash Redis via Vercel KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
